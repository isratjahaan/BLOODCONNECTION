# ===================================================
# BLOOD CONNECTION: ENVIRONMENT CONFIGURATION
# ===================================================

# Supabase API Credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL
VITE_APP_URL=https://bloodconnection.org.bd

# SMS / OTP Gateway Configuration (for Bangladesh e.g., Onnorokom SMS, Greenweb, SSL Wireless)
VITE_SMS_GATEWAY_URL=https://api.sms-gateway-bd.com/v2/send
VITE_SMS_API_KEY=your-sms-api-key

# Realtime & Geo
VITE_ENABLE_REALTIME=true
VITE_DEFAULT_LANGUAGE=en
